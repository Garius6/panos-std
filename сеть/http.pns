импорт строки
импорт сеть
импорт "кодирование/json" как json

// HTTP(S)-клиент. До этой сессии — самодельный сокет-парсер поверх
// сеть.подключиться (только http://, "читать до EOF" без Content-Length/
// chunked, только GET/POST). Теперь — тонкая обёртка над сеть.http_запрос
// (core builtin, backed by external/odin-http + OpenSSL, см. core/
// vm_http_native.odin): настоящий https, корректный Content-Length/
// chunked, все методы. Публичный API (Ответ/запросить/отправить_пост/
// построить_query) не менялся — старый код продолжает работать.

/// Разобранный HTTP-адрес (хост/порт/путь).
экспорт тип Адрес = структура
	хост: Строка
	порт: Целое
	путь: Строка
конец

/// Ответ HTTP-запроса (статус/заголовки/тело).
экспорт тип Ответ = структура
	статус:    Целое
	заголовки: Соответствие(Строка, Строка)
	тело:      Строка
конец

реализация Ответ
	функ успех(это: Ответ) -> Булево
		это.статус > 199 и это.статус < 300
	конец

	функ редирект(это: Ответ) -> Булево
		это.статус > 299 и это.статус < 400
	конец

	функ ошибка_клиента(это: Ответ) -> Булево
		это.статус > 399 и это.статус < 500
	конец

	функ ошибка_сервера(это: Ответ) -> Булево
		это.статус > 499 и это.статус < 600
	конец

	// Имена заголовков регистронезависимы по HTTP-спеке — native-клиент
	// (external/odin-http) хранит их в нижнем регистре внутри, поэтому
	// сравниваем по нижнему регистру, а не по тому, как вызывающий написал
	// имя (`.заголовок("Location")` и `.заголовок("location")` должны
	// работать одинаково).
	функ заголовок(это: Ответ, имя: Строка) -> Опция(Строка)
		пер искомое = строки.нижний_регистр(имя)
		если это.заголовки.есть(искомое) тогда
			Опция.Есть(это.заголовки.получить(искомое, ""))
		иначе
			Опция.Нет()
		конец
	конец
конец

// Линейный поиск подстроки — используется разобрать_адрес ниже И
// схема_и_хост (для резолва относительных Location при редиректах); сам
// http_запрос URL не парсит через panos — это делает native-клиент.
функ найти(текст: Строка, образец: Строка, от: Целое) -> Целое
	пер длина_текста = длина(текст)
	пер длина_образца = длина(образец)
	если длина_образца == 0 тогда
		возврат от
	конец
	пер позиция = от
	пока позиция + длина_образца < длина_текста или позиция + длина_образца == длина_текста цикл
		если строки.срез(текст, позиция, позиция + длина_образца) == образец тогда
			возврат позиция
		конец
		позиция = позиция + 1
	конец
	возврат -1
конец

// Сохранено для обратной совместимости (разбор URL без запроса) — только
// http://, как и раньше. Сам http_запрос принимает https:// напрямую и
// парсит URL внутри native-клиента, эта функция для него не используется.
/// Разбирает "http://хост[:порт][/путь]" в Адрес.
экспорт функ разобрать_адрес(текст: Строка) -> Результат(Адрес, Ошибка)
	если длина(текст) < 7 тогда
		возврат Результат.Неудача(Ошибка("http", "поддержан только http://, получено: " + текст))
	конец

	пер префикс = строки.срез(текст, 0, 7)
	если префикс <> "http://" тогда
		возврат Результат.Неудача(Ошибка("http", "поддержан только http://, получено: " + текст))
	конец
	пер остаток = строки.срез(текст, 7, длина(текст))

	пер конец_хоста = найти(остаток, "/", 0)
	пер хост_и_порт = остаток
	пер путь = "/"
	если конец_хоста <> -1 тогда
		хост_и_порт = строки.срез(остаток, 0, конец_хоста)
		путь = строки.срез(остаток, конец_хоста, длина(остаток))
	конец

	если длина(хост_и_порт) == 0 тогда
		возврат Результат.Неудача(Ошибка("http", "пустой хост в адресе: " + текст))
	конец

	пер разделитель_порта = найти(хост_и_порт, ":", 0)
	пер хост = хост_и_порт
	пер порт: Целое = 80
	если разделитель_порта <> -1 тогда
		хост = строки.срез(хост_и_порт, 0, разделитель_порта)
		пер порт_текст = строки.срез(хост_и_порт, разделитель_порта + 1, длина(хост_и_порт))
		пер порт_результат = строки.в_число(порт_текст)
		если порт_результат.ошибка() тогда
			возврат Результат.Неудача(Ошибка("http", "неверный порт в адресе: " + текст))
		конец
		порт = порт_результат.получить(80.0) как Целое
	конец

	возврат Результат.Успех(Адрес(хост, порт, путь))
конец

// "?a=b&c=d" с percent-encoding ключей/значений (сеть.кодировать_url).
// Пустая Соответствие -> пустая строка (не "?"). Вызывающий сам
// приклеивает результат к пути/URL перед хттп.запросить(...).
/// Строит query-строку "?a=b&c=d" (percent-encoded) из пар ключ-значение.
экспорт функ построить_query(параметры: Соответствие(Строка, Строка)) -> Строка
	пер записи = параметры.записи()
	если длина(записи) == 0 тогда
		возврат ""
	конец

	пер результат = "?"
	пер индекс: Целое = 0
	пока индекс < длина(записи) цикл
		пер запись = записи.получить(индекс, ("", ""))
		если индекс > 0 тогда
			результат = результат + "&"
		конец
		результат = результат + сеть.кодировать_url(запись.0) + "=" + сеть.кодировать_url(запись.1)
		индекс = индекс + 1
	конец
	возврат результат
конец

// Ключи — в нижнем регистре: имена HTTP-заголовков регистронезависимы
// по спеке, а `Ответ.заголовок(имя)` (ниже) ищет по нижнему регистру
// искомого имени — без нормализации здесь `.заголовок("Location")`
// не находил бы заголовок "Location", как он приходит НА ПРОВОДЕ (Zig
// std.http.Client сохраняет регистр как есть, не лоуеркейсит сам;
// старый комментарий про "native-клиент (external/odin-http)"
// устарел — тот клиент убран миграцией на Zig, см. HISTORICAL-пометку
// в CLAUDE.md). Найдено при добавлении http_запрос_без_редиректа —
// .заголовок("Location") на реальном ответе молча возвращал Опция.Нет().
функ пары_в_соответствие(пары: Массив((Строка, Строка))) -> Соответствие(Строка, Строка)
	пер результат: Соответствие(Строка, Строка) = соответствие()
	пер i: Целое = 0
	пока i < пары.длина() цикл
		пер пара = пары[i]
		результат[строки.нижний_регистр(пара.0)] = пара.1
		i = i + 1
	конец
	результат
конец

функ выполнить(метод: Строка, ссылка: Строка, тело: Строка, доп_заголовки: Соответствие(Строка, Строка)) -> Результат(Ответ, Ошибка)
	выбор сеть.http_запрос(метод, ссылка, тело, доп_заголовки)
		Результат.Успех(данные) -> собрать_ответ(данные.0, данные.1, данные.2)
		Результат.Неудача(ош) -> Результат.Неудача(ош)
	конец
конец

// Все функции выше СЛЕДУЮТ за 3xx-редиректами (Zig std.http.Client'а
// умолчание) — итоговый Ответ приходит УЖЕ после перехода, Location
// промежуточного 3xx недоступен. Ниже — намеренно БЕЗ этого: 3xx
// возвращается как есть, .заголовок("Location") читаем напрямую.
// Нужно вызывающему, которому важен сам факт/цель редиректа (например,
// OAuth2 authorization code в query редиректа), не итоговая страница.
функ выполнить_без_редиректа(метод: Строка, ссылка: Строка, тело: Строка, доп_заголовки: Соответствие(Строка, Строка)) -> Результат(Ответ, Ошибка)
	выбор сеть.http_запрос_без_редиректа(метод, ссылка, тело, доп_заголовки)
		Результат.Успех(данные) -> собрать_ответ(данные.0, данные.1, данные.2)
		Результат.Неудача(ош) -> Результат.Неудача(ош)
	конец
конец

/// GET-запрос, НЕ следующий за 3xx-редиректами — Ответ.статус — сам
/// редирект-код (301/302/...), Ответ.заголовок("Location") — куда.
экспорт функ запросить_без_редиректа(ссылка: Строка) -> Результат(Ответ, Ошибка)
	выполнить_без_редиректа("GET", ссылка, "", соответствие())
конец

/// POST-запрос с телом, НЕ следующий за 3xx-редиректами.
экспорт функ отправить_пост_без_редиректа(ссылка: Строка, тело: Строка) -> Результат(Ответ, Ошибка)
	выполнить_без_редиректа("POST", ссылка, тело, соответствие())
конец

/// POST-запрос с телом и заголовками, НЕ следующий за 3xx-редиректами.
экспорт функ отправить_пост_без_редиректа_с_заголовками(ссылка: Строка, тело: Строка, заголовки: Соответствие(Строка, Строка)) -> Результат(Ответ, Ошибка)
	выполнить_без_редиректа("POST", ссылка, тело, заголовки)
конец

функ собрать_ответ(статус_целое: Целое, пары: Массив((Строка, Строка)), тело: Строка) -> Результат(Ответ, Ошибка)
	Результат.Успех(Ответ(статус_целое, пары_в_соответствие(пары), тело))
конец

/// GET-запрос.
экспорт функ запросить(ссылка: Строка) -> Результат(Ответ, Ошибка)
	выполнить("GET", ссылка, "", соответствие())
конец

/// GET-запрос с дополнительными заголовками.
экспорт функ получить_с_заголовками(ссылка: Строка, заголовки: Соответствие(Строка, Строка)) -> Результат(Ответ, Ошибка)
	выполнить("GET", ссылка, "", заголовки)
конец

/// HEAD-запрос.
экспорт функ запросить_head(ссылка: Строка) -> Результат(Ответ, Ошибка)
	выполнить("HEAD", ссылка, "", соответствие())
конец

/// POST-запрос с телом.
экспорт функ отправить_пост(ссылка: Строка, тело: Строка) -> Результат(Ответ, Ошибка)
	выполнить("POST", ссылка, тело, соответствие())
конец

/// POST-запрос с телом и дополнительными заголовками.
экспорт функ отправить_пост_с_заголовками(ссылка: Строка, тело: Строка, заголовки: Соответствие(Строка, Строка)) -> Результат(Ответ, Ошибка)
	выполнить("POST", ссылка, тело, заголовки)
конец

/// PUT-запрос с телом.
экспорт функ отправить_put(ссылка: Строка, тело: Строка) -> Результат(Ответ, Ошибка)
	выполнить("PUT", ссылка, тело, соответствие())
конец

/// PUT-запрос с телом и дополнительными заголовками.
экспорт функ отправить_put_с_заголовками(ссылка: Строка, тело: Строка, заголовки: Соответствие(Строка, Строка)) -> Результат(Ответ, Ошибка)
	выполнить("PUT", ссылка, тело, заголовки)
конец

/// PATCH-запрос с телом.
экспорт функ отправить_patch(ссылка: Строка, тело: Строка) -> Результат(Ответ, Ошибка)
	выполнить("PATCH", ссылка, тело, соответствие())
конец

/// PATCH-запрос с телом и дополнительными заголовками.
экспорт функ отправить_patch_с_заголовками(ссылка: Строка, тело: Строка, заголовки: Соответствие(Строка, Строка)) -> Результат(Ответ, Ошибка)
	выполнить("PATCH", ссылка, тело, заголовки)
конец

/// DELETE-запрос.
экспорт функ удалить(ссылка: Строка) -> Результат(Ответ, Ошибка)
	выполнить("DELETE", ссылка, "", соответствие())
конец

/// DELETE-запрос с дополнительными заголовками.
экспорт функ удалить_с_заголовками(ссылка: Строка, заголовки: Соответствие(Строка, Строка)) -> Результат(Ответ, Ошибка)
	выполнить("DELETE", ссылка, "", заголовки)
конец

// Content-Type: application/json + json.сериализовать(значение) одним
// вызовом.
/// POST-запрос с JSON-телом (Content-Type: application/json выставляется сам).
экспорт функ отправить_json(ссылка: Строка, значение: json.Значение) -> Результат(Ответ, Ошибка)
	пер заголовки: Соответствие(Строка, Строка) = соответствие()
	заголовки["Content-Type"] = "application/json"
	выполнить("POST", ссылка, json.сериализовать(значение), заголовки)
конец

// Схема+хост ("https://example.com") без пути — Location часто приходит
// относительным ("/путь", RFC 7231 разрешает), нужно приклеить его к
// схеме+хосту ИСХОДНОГО запроса, иначе native-клиент не сможет разобрать
// голый путь как URL.
функ схема_и_хост(url: Строка) -> Строка
	пер конец_схемы = найти(url, "://", 0)
	если конец_схемы == -1 тогда
		возврат url
	конец
	пер после_схемы = конец_схемы + 3
	пер конец_хоста = найти(url, "/", после_схемы)
	если конец_хоста == -1 тогда
		возврат url
	конец
	строки.срез(url, 0, конец_хоста)
конец

функ разрешить_location(база: Строка, location: Строка) -> Строка
	если длина(location) >= 7 и строки.срез(location, 0, 7) == "http://" тогда
		возврат location
	конец
	если длина(location) >= 8 и строки.срез(location, 0, 8) == "https://" тогда
		возврат location
	конец
	схема_и_хост(база) + location
конец

// Следует за 3xx-редиректами (заголовок Location, абсолютным или
// относительным) до макс_переходов раз. Возвращает первый НЕ-редирект
// ответ, либо Ошибку при превышении лимита или отсутствии Location в
// редиректе.
/// GET-запрос, следующий за 3xx-редиректами до макс_переходов раз.
экспорт функ запросить_с_редиректами(ссылка: Строка, макс_переходов: Целое) -> Результат(Ответ, Ошибка)
	пер текущая_ссылка = ссылка
	пер переходов: Целое = 0
	пока переходов < макс_переходов цикл
		пер результат = запросить(текущая_ссылка)
		если результат.ошибка() тогда
			возврат результат
		конец
		пер ответ = результат.ожидать("проверено выше")
		если не ответ.редирект() тогда
			возврат Результат.Успех(ответ)
		конец
		пер расположение = ответ.заголовок("Location")
		если расположение.пусто() тогда
			возврат Результат.Успех(ответ)
		конец
		текущая_ссылка = разрешить_location(текущая_ссылка, расположение.получить(""))
		переходов = переходов + 1
	конец
	Результат.Неудача(Ошибка("http", "превышен лимит редиректов (" + строки.из_целого(макс_переходов) + ")"))
конец

// HTTP-СЕРВЕР. Тонкая сахарная обёртка над низкоуровневым accept-loop API
// (сеть.http_сервер_слушать/.принять_запрос()/.ответить(...), core builtin
// — specs/009-http-server): прячет per-итерацию ошибка()/значение()-
// развёртывание Результата и позволяет писать обработчик как обычную
// функцию Запрос -> ОтветСервера, а не ответить(...) с ручным
// вызовом. Функциональный тип-алиас (Обработчик) читается короче, чем
// инлайн функ(Запрос)->ОтветСервера в каждой сигнатуре.

/// Ответ, который возвращает Обработчик — обслуживать/обслуживать_слушатель
/// сами вызывают Запрос.ответить_с_заголовками(...) с этими полями —
/// заголовки нужны для редиректов (Location) и сессионных cookie
/// (Set-Cookie), которых у status+content-type+body нет способа
/// выразить; ПУСТОЕ Соответствие (см. ответ ниже) — обычный ответ без
/// дополнительных заголовков, эквивалентный старому 3-полевому виду.
экспорт тип ОтветСервера = структура
	статус:         Целое
	тип_содержимого: Строка
	тело:           Строка
	заголовки:      Соответствие(Строка, Строка)
конец

/// ОтветСервера без дополнительных заголовков — сокращение для самого
/// частого случая (JSON/text-ответы, никакого Location/Set-Cookie).
экспорт функ ответ(статус: Целое, тип_содержимого: Строка, тело: Строка) -> ОтветСервера
	ОтветСервера(статус, тип_содержимого, тело, соответствие())
конец

/// 302-редирект на путь/URL — Location в заголовках, пустое тело.
/// Основной способ завершить OAuth2/OIDC authorization-запрос
/// (`код`/`ошибка` в query редиректа) без ручной сборки Соответствия.
экспорт функ ответ_редирект(путь: Строка) -> ОтветСервера
	пер заголовки: Соответствие(Строка, Строка) = соответствие()
	заголовки["Location"] = путь
	ОтветСервера(302, "text/plain", "", заголовки)
конец

/// Функция-обработчик одного HTTP-запроса.
экспорт тип Обработчик = функ(Запрос) -> ОтветСервера

// Ошибки отдельных принять_запрос() (например, клиент оборвал соединение
// до ответа) молча пропускаются — тот же best-effort принцип, что и у
// низкоуровневого API (spec.md Edge Case: "не должен паниковать").
/// Обработка ОДНОГО уже принятого соединения — вызов обработчика и
/// отправка ответа. Отдельная функция (не тело цикла обслуживать_слушатель
/// напрямую), потому что обслуживать_слушатель спавнит её через `запусти`
/// на каждое соединение — см. комментарий там про то, зачем.
функ обработать_соединение(запрос: Запрос, обработчик: Обработчик) -> Пусто
	пер ответ = обработчик(запрос)
	запрос.ответить_с_заголовками(ответ.статус, ответ.тип_содержимого, ответ.тело, ответ.заголовки)
конец

// По образцу Go (net/http: `for { c := accept(); go c.serve() }`) и
// Erlang/Cowboy (пул акцепторов делает ТОЛЬКО accept, обработка — в
// отдельном процессе на соединение): accept и обработка запроса — РАЗНЫЕ
// задачи, никогда не в одном последовательном цикле. Раньше здесь было
// `обработчик(запрос)` ПРЯМО в теле цикла — единственный процесс
// (обслуживать(..., 1.0)) не мог принять СЛЕДУЮЩЕЕ соединение, пока не
// закончит текущий обработчик целиком (включая ЕГО СОБСТВЕННЫЙ downstream
// I/O — типичная OAuth2-callback-схема) — реальный, воспроизведённый
// вживую footgun (panosiki/дозорный, git log). `запусти
// обработать_соединение(...)` чинит это структурно: принять_запрос()
// вызывается СНОВА немедленно после спавна, не дожидаясь ответа.
/// Accept-цикл над уже открытым Слушателем — никогда не возвращается.
/// Несколько процессов МОГУТ звать это над ОДНИМ И ТЕМ ЖЕ Слушателем
/// (сеть.http_сервер_слушать вызывается для порта РОВНО один раз,
/// повторный бинд — ошибка), но с этой версии не ОБЯЗАНЫ для
/// корректности — каждое соединение и так обрабатывается в своём
/// процессе; несколько accept-процессов имеют смысл только под очень
/// высокой частотой НОВЫХ соединений (сам accept() либо TCP-очередь —
/// не обработка запросов).
экспорт функ обслуживать_слушатель(слушатель: Слушатель, обработчик: Обработчик) -> Пусто
	пока истина цикл
		пер запрос_рез = слушатель.принять_запрос()
		если не запрос_рез.ошибка() тогда
			запусти обработать_соединение(запрос_рез.значение(), обработчик)
		конец
	конец
конец

/// Слушает порт и запускает процессов НЕЗАВИСИМЫХ accept-циклов над ним
/// (1 = единственный accept-цикл — С этой версии БЕЗОПАСНО для реальной
/// нагрузки: обслуживать_слушатель сам спавнит обработчик на каждое
/// соединение, см. её комментарий, — процессов здесь только про
/// конкурентность самого accept(), не про защиту от медленных
/// обработчиков). При успехе никогда не возвращается, Результат только
/// для ошибки бинда (порт занят и т.п.); Число в успехе не несёт смысла
/// (всегда 0) — та же причина, что фс.создать_директорию не возвращает
/// Результат(Пусто, ...): Пусто в этой системе типов не конструируемое
/// значение.
экспорт функ обслуживать(порт: Целое, обработчик: Обработчик, процессов: Число) -> Результат(Число, Ошибка)
	пер слушатель_рез = сеть.http_сервер_слушать(порт)
	если слушатель_рез.ошибка() тогда
		возврат Результат.Неудача(слушатель_рез.причина())
	конец
	пер слушатель = слушатель_рез.значение()

	пер i: Число = 1.0
	пока i < процессов цикл
		запусти обслуживать_слушатель(слушатель, обработчик)
		i = i + 1.0
	конец
	обслуживать_слушатель(слушатель, обработчик)
	Результат.Успех(0.0)
конец

// РОУТЕР. Общий помощник разбить_путь используется и при компиляции
// шаблона (скомпилировать_путь), и при разборе реального пути запроса
// (Маршрутизатор.обработать/сопоставить_путь) — одной и той же логикой с
// обеих сторон, иначе число сегментов могло бы разойтись (ведущий/конечный
// "/" не должен порождать пустой сегмент ни там, ни там).
// Разделяет СЫРОЙ request-target ("/путь?a=b&c=d") на путь и query ДО
// какого-либо percent-декодирования — "?" в самом percent-encoded пути
// невозможен (RFC 3986, зарезервированный байт кодируется как %3F), так
// что первое литеральное "?" всегда граница пути и query, безопасно
// искать даже в непрочитанном сыром тексте.
функ разделить_query(сырой_путь: Строка) -> (Строка, Строка)
	пер позиция = строки.найти(сырой_путь, "?", 0)
	если позиция < 0 тогда
		возврат (сырой_путь, "")
	конец
	(строки.срез(сырой_путь, 0, позиция), строки.срез(сырой_путь, позиция + 1, длина(сырой_путь)))
конец

// application/x-www-form-urlencoded (RFC 1866, унаследовано и query-
// строкой, и телом form-POST) кодирует ПРОБЕЛ как "+", не "%20" —
// отдельная от общего сеть.декодировать_url конвенция (там "+" —
// буквальный плюс, как в пути URL, RFC 3986). "+" заменяется ПЕРЕД
// percent-декодированием — закодированный литеральный "+" в значении
// сам придёт как "%2B" и этим шагом не тронется.
функ декодировать_www_form_компонент(текст: Строка) -> Строка
	сеть.декодировать_url(строки.заменить(текст, "+", " "))
конец

/// Разбирает query-строку "a=b&c=d" (без ведущего "?") в Соответствие —
/// обратная операция к построить_query. Пустая query -> пустое
/// Соответствие. Пара без "=" (просто "флаг") -> значение "" (не
/// пропускается — присутствие ключа само по себе иногда значимо).
экспорт функ разобрать_query(query: Строка) -> Соответствие(Строка, Строка)
	пер результат: Соответствие(Строка, Строка) = соответствие()
	если длина(query) == 0 тогда
		возврат результат
	конец
	пер пары = строки.разбить(query, "&")
	пер i: Целое = 0
	пока i < пары.длина() цикл
		пер пара = пары[i]
		пер позиция_равно = строки.найти(пара, "=", 0)
		если позиция_равно < 0 тогда
			результат[декодировать_www_form_компонент(пара)] = ""
		иначе
			пер ключ = строки.срез(пара, 0, позиция_равно)
			пер значение = строки.срез(пара, позиция_равно + 1, длина(пара))
			результат[декодировать_www_form_компонент(ключ)] = декодировать_www_form_компонент(значение)
		конец
		i = i + 1
	конец
	результат
конец

функ разбить_путь(путь: Строка) -> Массив(Строка)
	пер части = строки.разбить(путь, "/")
	пер сегменты: Массив(Строка) = массив()
	пер i: Целое = 0
	пока i < части.длина() цикл
		если длина(части[i]) > 0 тогда
			сегменты.добавить(части[i])
		конец
		i = i + 1
	конец
	сегменты
конец

/// Один сегмент скомпилированного шаблона пути.
экспорт тип Сегмент_Шаблона = перечисление
	Литерал(Строка)
	Параметр(Строка)
конец

// Компилируется ОДИН РАЗ при регистрации маршрута (Маршрутизатор.
// получить и т.п.), не на каждый запрос — пересборка сырой строки шаблона
// на каждый запрос стоила бы N лишних Разбить()-аллокаций на каждый из N
// зарегистрированных маршрутов (runtime-строки в этой VM не интернированы
// — каждый срез/сплит аллоцирует новый Panos_String, а GC stop-the-world:
// лишние аллокации это лишние паузы ВСЕЙ VM, включая другие запущенные
// через запусти процессы-обработчики, не только текущий запрос).
/// Скомпилированный шаблон пути ("/пользователи/:id" -> сегменты).
экспорт тип Шаблон_Пути = структура
	сегменты: Массив(Сегмент_Шаблона)
конец

/// Компилирует "/пользователи/:id" в Шаблон_Пути.
экспорт функ скомпилировать_путь(шаблон: Строка) -> Шаблон_Пути
	пер части = разбить_путь(шаблон)
	пер сегменты: Массив(Сегмент_Шаблона) = массив()
	пер i: Целое = 0
	пока i < части.длина() цикл
		если строки.начинается_с(части[i], ":") тогда
			сегменты.добавить(Сегмент_Шаблона.Параметр(строки.срез(части[i], 1, длина(части[i]))))
		иначе
			сегменты.добавить(Сегмент_Шаблона.Литерал(части[i]))
		конец
		i = i + 1
	конец
	Шаблон_Пути(сегменты)
конец

функ имя_параметра(сегмент: Сегмент_Шаблона) -> Опция(Строка)
	выбор сегмент
		Параметр(имя) -> Опция.Есть(имя)
		Литерал(_) -> Опция.Нет()
	конец
конец

// Сопоставляет УЖЕ РАЗБИТЫЙ на сегменты путь против УЖЕ СКОМПИЛИРОВАННОГО
// шаблона — вызывающий (Маршрутизатор.обработать) разбивает путь запроса
// ОДИН раз и переиспользует сегменты для каждого кандидата-маршрута,
// вместо пересборки на каждый. Соответствие параметров НЕ аллоцируется,
// пока совпадение не подтверждено целиком (первый проход — только
// дешёвое сравнение литеральных сегментов, без единой аллокации; второй
// проход, только на подтверждённом совпадении, строит параметры).
функ сопоставить_сегменты(шаблон: Шаблон_Пути, сегменты_пути: Массив(Строка)) -> Опция(Соответствие(Строка, Строка))
	если шаблон.сегменты.длина() <> сегменты_пути.длина() тогда
		возврат Опция.Нет()
	конец

	пер i: Целое = 0
	пока i < шаблон.сегменты.длина() цикл
		пер совпал = выбор шаблон.сегменты[i]
			Литерал(текст) -> текст == сегменты_пути[i]
			Параметр(_) -> истина
		конец
		если не совпал тогда
			возврат Опция.Нет()
		конец
		i = i + 1
	конец

	пер параметры: Соответствие(Строка, Строка) = соответствие()
	i = 0
	пока i < шаблон.сегменты.длина() цикл
		пер возможное_имя = имя_параметра(шаблон.сегменты[i])
		если возможное_имя.есть() тогда
			параметры[возможное_имя.получить("")] = сегменты_пути[i]
		конец
		i = i + 1
	конец
	Опция.Есть(параметры)
конец

// Удобно для ручного `выбор`-диспетчинга без Маршрутизатор (Вариант Б —
// см. обсуждение дизайна). Компилирует шаблон заново при КАЖДОМ вызове —
// ок для нечастого/ручного использования; Маршрутизатор эту функцию НЕ
// вызывает, у него свой путь с уже скомпилированными Шаблон_Пути и
// однократным разбором пути запроса (см. Маршрутизатор.обработать ниже).
/// Разовое сопоставление "/пользователи/:id" против конкретного пути.
экспорт функ сопоставить_путь(шаблон: Строка, путь: Строка) -> Опция(Соответствие(Строка, Строка))
	сопоставить_сегменты(скомпилировать_путь(шаблон), разбить_путь(путь))
конец

// Запрос сам нативный opaque-тип (core builtin) — нельзя дописать в него
// поле параметры из panos-кода, поэтому Маршрутизатор передаёт
// обработчику эту обёртку вместо голого Запроса.
/// Запрос, обёрнутый Маршрутизатором — несёт извлечённые :param'ы и
/// разобранную query-строку (?a=b&c=d, пусто, если её не было).
экспорт тип ЗапросМаршрута = структура
	запрос:    Запрос
	параметры: Соответствие(Строка, Строка)
	query:     Соответствие(Строка, Строка)
конец

/// Функция-обработчик ОДНОГО зарегистрированного маршрута (в отличие от
/// Обработчик выше — тот на весь Слушатель, без знания о конкретном пути).
экспорт тип ОбработчикМаршрута = функ(ЗапросМаршрута) -> ОтветСервера

тип Маршрут = структура
	метод:      Строка
	шаблон:     Шаблон_Пути
	обработчик: ОбработчикМаршрута
конец

// Маршрутизатор — структура, то есть ссылочный тип в этой VM (см.
// core/vm.odin Set_Local — копируется указатель, не поля): методы
// получить/отправить_пост/... мутируют ЕЁ ЖЕ поле маршруты, поэтому
// порядок регистрации маршрутов относительно .как_обработчик() не важен
// для корректности — замыкание держит указатель на тот же объект, и
// последующая регистрация видна через него. Регистрация-потом-
// обслуживание — просто рекомендуемый стиль (как у любой другой
// роутинг-библиотеки), не требование корректности здесь. Конкурентное
// чтение таблицы маршрутов из нескольких процессов-обработчиков
// (обслуживать с процессов > 1) безопасно без блокировок — VM исполняет
// процессы кооперативно на одном ОС-потоке, настоящего параллелизма нет.
/// Роутер поверх обслуживать/обслуживать_слушатель — регистрируй маршруты
/// методами получить/отправить_пост/..., затем .как_обработчик() в
/// обслуживать(...).
экспорт тип Маршрутизатор = структура
	маршруты: Массив(Маршрут)
конец

/// Создаёт пустой Маршрутизатор.
экспорт функ маршрутизатор() -> Маршрутизатор
	Маршрутизатор(массив())
конец

реализация Маршрутизатор
	функ добавить(это: Маршрутизатор, метод: Строка, шаблон: Строка, обработчик: ОбработчикМаршрута) -> Пусто
		это.маршруты.добавить(Маршрут(метод, скомпилировать_путь(шаблон), обработчик))
	конец

	/// Регистрирует обработчик GET-запросов на шаблон пути.
	функ получить(это: Маршрутизатор, шаблон: Строка, обработчик: ОбработчикМаршрута) -> Пусто
		это.добавить("GET", шаблон, обработчик)
	конец

	/// Регистрирует обработчик POST-запросов на шаблон пути.
	функ отправить_пост(это: Маршрутизатор, шаблон: Строка, обработчик: ОбработчикМаршрута) -> Пусто
		это.добавить("POST", шаблон, обработчик)
	конец

	/// Регистрирует обработчик PUT-запросов на шаблон пути.
	функ отправить_put(это: Маршрутизатор, шаблон: Строка, обработчик: ОбработчикМаршрута) -> Пусто
		это.добавить("PUT", шаблон, обработчик)
	конец

	/// Регистрирует обработчик PATCH-запросов на шаблон пути.
	функ отправить_patch(это: Маршрутизатор, шаблон: Строка, обработчик: ОбработчикМаршрута) -> Пусто
		это.добавить("PATCH", шаблон, обработчик)
	конец

	/// Регистрирует обработчик DELETE-запросов на шаблон пути.
	функ удалить(это: Маршрутизатор, шаблон: Строка, обработчик: ОбработчикМаршрута) -> Пусто
		это.добавить("DELETE", шаблон, обработчик)
	конец

	// Путь запроса разбирается на сегменты ОДИН РАЗ и переиспользуется
	// для всех зарегистрированных маршрутов (не на каждый кандидат);
	// метод (дешёвое сравнение коротких строк) фильтрует раньше, чем
	// посегментное сравнение — сопоставить_сегменты вообще не вызывается
	// для маршрутов с другим методом.
	функ обработать(это: Маршрутизатор, запрос: Запрос) -> ОтветСервера
		// Реальный HTTP-клиент percent-encode'ит некириллические байты
		// пути на проводе (RFC 3986) — сравнивать сырой запрос.путь() с
		// буквальным кириллическим шаблоном маршрута ("/api/задачи")
		// значит НИКОГДА не совпадать: клиент шлёт "/api/%d0%b7...".
		// Декодируем ОДИН раз здесь (не внутри разбить_путь — та же
		// функция используется и для компиляции самого шаблона маршрута,
		// который percent-encoded не бывает).
		пер разделено = разделить_query(запрос.путь())
		пер путь = сеть.декодировать_url(разделено.0)
		пер query = разобрать_query(разделено.1)
		пер сегменты_пути = разбить_путь(путь)
		пер метод = запрос.метод()
		пер i: Целое = 0
		пока i < это.маршруты.длина() цикл
			пер маршрут = это.маршруты[i]
			если маршрут.метод == метод тогда
				пер совпадение = сопоставить_сегменты(маршрут.шаблон, сегменты_пути)
				если совпадение.есть() тогда
					возврат маршрут.обработчик(ЗапросМаршрута(запрос, совпадение.получить(соответствие()), query))
				конец
			конец
			i = i + 1
		конец
		ответ(404, "text/plain", "не найдено: " + путь)
	конец

	/// Преобразует Маршрутизатор в Обработчик, совместимый с
	/// обслуживать/обслуживать_слушатель.
	функ как_обработчик(это: Маршрутизатор) -> Обработчик
		функ(запрос: Запрос) -> ОтветСервера
			это.обработать(запрос)
		конец
	конец
конец

// СТАТИЧЕСКИЕ ФАЙЛЫ. Простая таблица расширение->Content-Type —
// расширяется по мере необходимости, не претендует на полноту (см.
// mime_по_расширению).
функ mime_по_расширению(путь: Строка) -> Строка
	если строки.заканчивается_на(путь, ".html") или строки.заканчивается_на(путь, ".htm") тогда
		возврат "text/html"
	конец
	если строки.заканчивается_на(путь, ".css") тогда
		возврат "text/css"
	конец
	если строки.заканчивается_на(путь, ".js") тогда
		возврат "application/javascript"
	конец
	если строки.заканчивается_на(путь, ".json") тогда
		возврат "application/json"
	конец
	если строки.заканчивается_на(путь, ".svg") тогда
		возврат "image/svg+xml"
	конец
	если строки.заканчивается_на(путь, ".txt") тогда
		возврат "text/plain"
	конец
	если строки.заканчивается_на(путь, ".xml") тогда
		возврат "application/xml"
	конец
	"application/octet-stream"
конец

// "/" -> корень/индекс_файл, любой другой путь запроса — корень + путь
// (ведущий "/" не дублируется).
функ путь_к_файлу(корень: Строка, путь_запроса: Строка, индекс_файл: Строка) -> Строка
	если путь_запроса == "/" тогда
		возврат корень + "/" + индекс_файл
	конец
	если строки.начинается_с(путь_запроса, "/") тогда
		возврат корень + путь_запроса
	конец
	корень + "/" + путь_запроса
конец

// ВАЖНО: тело ОтветСервера — Строка, а строки в panos обязаны быть
// валидным UTF-8 — файлы текстовых форматов (html/css/js/json/svg/txt)
// отдаются корректно, произвольные бинарные файлы (картинки, шрифты,
// и т.п.) НЕ гарантированно (см. фс.прочитать — читает как есть, но
// строковый рантайп поверх уже проверяет UTF-8 на операциях вроде
// длины).
/// Отдаёт файл с диска как ОтветСервера — 404, если файла нет или это
/// каталог, 403 при попытке выйти за пределы каталога через "..".
/// Content-Type определяется по расширению (mime_по_расширению).
экспорт функ отдать_файл(путь: Строка) -> ОтветСервера
	если строки.содержит(путь, "..") тогда
		возврат ответ(403, "text/plain", "запрещено")
	конец
	если (не фс.есть(путь)) или фс.это_директория(путь) тогда
		возврат ответ(404, "text/plain", "не найдено: " + путь)
	конец
	выбор фс.прочитать(путь)
		Результат.Успех(содержимое) -> ответ(200, mime_по_расширению(путь), содержимое)
		Результат.Неудача(ош) -> ответ(500, "text/plain", "ошибка чтения: " + ош.сообщение)
	конец
конец

/// Обработчик, раздающий статические файлы из каталога корень — "/"
/// отдаёт корень/индекс_файл, любой другой путь запроса — корень + путь
/// (с защитой от выхода за пределы каталога через "..", см.
/// отдать_файл). Используй как обычный Обработчик:
/// http.обслуживать(порт, http.статический_обработчик("./public",
/// "index.html"), 1). НЕ встроен в Маршрутизатор — тому потребовался бы
/// wildcard-сегмент шаблона пути, которого сейчас нет; для сочетания
/// API-маршрутов со статикой пиши свой Обработчик, который сначала
/// пробует Маршрутизатор.обработать(запрос), а на 404 — отдать_файл(...).
экспорт функ статический_обработчик(корень: Строка, индекс_файл: Строка) -> Обработчик
	функ(запрос: Запрос) -> ОтветСервера
		// см. Маршрутизатор.обработать — тот же percent-decode нужен
		// здесь для файлов с некириллическими символами в имени.
		отдать_файл(путь_к_файлу(корень, сеть.декодировать_url(запрос.путь()), индекс_файл))
	конец
конец
