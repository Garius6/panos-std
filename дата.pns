импорт математика
импорт строки

функ floordiv(a: Число, b: Число) -> Число
	математика.округл_вниз(a / b)
конец

// Ведущий ноль для x в [0, 99] — час/минута/секунда/месяц/день ЛЕГКО в
// этом диапазоне, строки.из_числа безопасна тут (scientific notation у
// неё начинается с ~7 значащих цифр, см. std/слог.ps).
функ дополнить_нулём(x: Число) -> Строка
	если x < 10.0 тогда
		"0" + строки.из_числа(x)
	иначе
		строки.из_числа(x)
	конец
конец

// civil_from_days (Howard Hinnant, http://howardhinnant.github.io/date_algorithms.html)
// — чистая арифметика, без високосно-годовых if/else таблиц. Перенесена
// СОЗНАТЕЛЬНО НЕ целиком: оригинал различает era для z < 0 (даты ДО
// 1970-01-01) — здесь этот branch убран, z (дни с эпохи) обязан быть
// НЕОТРИЦАТЕЛЬНЫМ. Единственный вызывающий (форматировать_utc) кормит
// сюда время.сейчас_мс() — даты до 1970 года никогда не возникают на
// практике для логов, а тащить полную (отрицательную) ветку ради
// неиспользуемого случая — необязательный риск тихой ошибки в
// date-математике.
функ дней_в_дату(z: Число) -> (Число, Число, Число)
	пер z2 = z + 719468.0
	пер era = floordiv(z2, 146097.0)
	пер doe = z2 - era * 146097.0
	пер yoe = floordiv(doe - floordiv(doe, 1460.0) + floordiv(doe, 36524.0) - floordiv(doe, 146096.0), 365.0)
	пер y = yoe + era * 400.0
	пер doy = doe - (365.0 * yoe + floordiv(yoe, 4.0) - floordiv(yoe, 100.0))
	пер mp = floordiv(5.0 * doy + 2.0, 153.0)
	пер d = doy - floordiv(153.0 * mp + 2.0, 5.0) + 1.0
	пер m = если mp < 10.0 тогда mp + 3.0 иначе mp - 9.0 конец
	пер год = если m <= 2.0 тогда y + 1.0 иначе y конец
	(год, m, d)
конец

// Погрешность деления с плавающей точкой на числах такого порядка
// (epoch_мс ~10^12) в принципе может дать x.999999999 вместо x.0 у
// границы секунды/дня — не обёрнуто в защитный округлить(), т.к. для
// временной метки лога это не критично (не ожидается точность до мс,
// только читаемость).
/// Форматирует epoch-миллисекунды (UTC, `время.сейчас_мс()`) как
/// "ГГГГ-ММ-ДД ЧЧ:ММ:СС". Только для НЕОТРИЦАТЕЛЬНЫХ x (1970-01-01 и
/// позже) — см. дней_в_дату.
экспорт функ форматировать_utc(epoch_мс: Число) -> Строка
	пер epoch_с = математика.округл_вниз(epoch_мс / 1000.0)
	пер дней = floordiv(epoch_с, 86400.0)
	пер секунд_в_дне = epoch_с - дней * 86400.0
	пер (год, месяц, день) = дней_в_дату(дней)
	пер час = floordiv(секунд_в_дне, 3600.0)
	пер минута = floordiv(секунд_в_дне - час * 3600.0, 60.0)
	пер секунда = секунд_в_дне - час * 3600.0 - минута * 60.0
	строки.из_числа(год) + "-" + дополнить_нулём(месяц) + "-" + дополнить_нулём(день) +
		" " + дополнить_нулём(час) + ":" + дополнить_нулём(минута) + ":" + дополнить_нулём(секунда)
конец
