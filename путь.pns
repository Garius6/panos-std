// Манипуляция путями — чистая строковая логика поверх `строки`, без
// обращения к файловой системе (это не `фс` — тут ничего не читается и
// не пишется на диск). POSIX-стиль (`/`), Windows-разделитель `\`/буква
// диска (`C:\`) не распознаётся — реальную ОС-специфику путей решает
// `фс` на уровне фактического I/O, этот модуль — только удобство для
// текстовой работы с путями (сборка/разбор строк).
импорт строки

/// Склеивает два сегмента ровно одним "/" между ними — не дублирует
/// разделитель, если он уже есть на стыке; пустой сегмент просто
/// отбрасывается.
экспорт функ соединить(а: Строка, б: Строка) -> Строка
	если а == "" тогда
		возврат б
	конец
	если б == "" тогда
		возврат а
	конец
	пер а_кончается = строки.заканчивается_на(а, "/")
	пер б_начинается = строки.начинается_с(б, "/")
	если а_кончается и б_начинается тогда
		возврат а + строки.срез(б, 1, длина(б))
	конец
	если а_кончается или б_начинается тогда
		возврат а + б
	конец
	а + "/" + б
конец

/// Склеивает произвольное число сегментов через `соединить`.
экспорт функ соединить_все(сегменты: Массив(Строка)) -> Строка
	пер результат = ""
	для сегмент в сегменты цикл
		результат = соединить(результат, сегмент)
	конец
	результат
конец

/// Непустые сегменты пути (без пустых строк от ведущего/двойного "/").
функ непустые_сегменты(путь: Строка) -> Массив(Строка)
	пер сегменты = строки.разбить(путь, "/")
	пер результат: Массив(Строка) = массив()
	для сегмент в сегменты цикл
		если сегмент <> "" тогда
			результат.добавить(сегмент)
		конец
	конец
	результат
конец

/// Базовое имя — последний сегмент пути.
экспорт функ имя_файла(путь: Строка) -> Строка
	пер сегменты = непустые_сегменты(путь)
	если длина(сегменты) == 0 тогда
		возврат ""
	конец
	сегменты[длина(сегменты) - 1]
конец

/// Путь без последнего сегмента — сохраняет ведущий "/" для абсолютных
/// путей. Заодно схлопывает случайные "//" (побочный эффект фильтрации
/// пустых сегментов).
экспорт функ директория(путь: Строка) -> Строка
	пер абс = строки.начинается_с(путь, "/")
	пер сегменты = непустые_сегменты(путь)
	если длина(сегменты) <= 1 тогда
		если абс тогда
			возврат "/"
		конец
		возврат ""
	конец
	пер без_последнего = сегменты.срез(0, длина(сегменты) - 1)
	пер результат = соединить_все(без_последнего)
	если абс тогда
		"/" + результат
	иначе
		результат
	конец
конец

/// Расширение файла (без точки) — ищется в базовом имени, не во всём
/// пути (иначе точки в именах директорий ложно матчились бы). `Нет()`,
/// если точки нет или файл скрытый (".gitignore"-стиль: имя начинается
/// с точки и больше точек не содержит).
экспорт функ расширение(путь: Строка) -> Опция(Строка)
	пер база = имя_файла(путь)
	пер сегменты = строки.разбить(база, ".")
	если длина(сегменты) <= 1 тогда
		возврат Опция.Нет()
	конец
	если длина(сегменты) == 2 и сегменты[0] == "" тогда
		возврат Опция.Нет()
	конец
	Опция.Есть(сегменты[длина(сегменты) - 1])
конец

/// Путь с обрезанным расширением (если оно есть).
экспорт функ без_расширения(путь: Строка) -> Строка
	выбор расширение(путь)
		Есть(ext) тогда
			пер база = имя_файла(путь)
			пер без_ext = строки.срез(база, 0, длина(база) - длина(ext) - 1)
			соединить(директория(путь), без_ext)
		конец
		Нет -> путь
	конец
конец

/// Начинается ли путь с "/" (POSIX-абсолютный).
экспорт функ абсолютный(путь: Строка) -> Булево
	строки.начинается_с(путь, "/")
конец
