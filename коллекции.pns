// Дженерик-комбинаторы поверх Массив — чистый panos (Стадия 7: generic
// функции), без единого native-изменения. "отсортировать" — insertion
// sort (просто, стабильно; для больших массивов производительность не
// приоритет). Компаратор-лямбда, а не встроенный `<`, — panos не
// сравнивает Строку/структуры/массивы через `<` (только Число), так что
// generic-сортировка в принципе не может опереться на язык.

/// Оставляет только элементы, для которых предикат вернул истину.
экспорт функ отфильтровать[T](массив: Массив(T), предикат: функ(T) -> Булево) -> Массив(T)
	пер результат: Массив(T) = массив()
	для элемент в массив цикл
		если предикат(элемент) тогда
			результат.добавить(элемент)
		конец
	конец
	результат
конец

/// Применяет преобразование к каждому элементу, возвращает новый массив.
экспорт функ отобразить[T, U](массив: Массив(T), преобразование: функ(T) -> U) -> Массив(U)
	пер результат: Массив(U) = массив()
	для элемент в массив цикл
		результат.добавить(преобразование(элемент))
	конец
	результат
конец

/// Сворачивает массив в одно значение слева направо: начало, затем шаг(накопитель, элемент) на каждом элементе.
экспорт функ свернуть[T, U](массив: Массив(T), начало: U, шаг: функ(U, T) -> U) -> U
	пер накопитель = начало
	для элемент в массив цикл
		накопитель = шаг(накопитель, элемент)
	конец
	накопитель
конец

/// Сортирует копию массива (insertion sort) по компаратору "меньше".
экспорт функ отсортировать[T](массив: Массив(T), меньше: функ(T, T) -> Булево) -> Массив(T)
	пер результат: Массив(T) = массив()
	для элемент в массив цикл
		результат.добавить(элемент)
	конец
	пер i: Целое = 1
	пока i < результат.длина() цикл
		пер ключ = результат[i]
		пер j = i - 1
		пока j > -1 и меньше(ключ, результат[j]) цикл
			результат[j + 1] = результат[j]
			j = j - 1
		конец
		результат[j + 1] = ключ
		i = i + 1
	конец
	результат
конец

/// Первый элемент, для которого предикат вернул истину.
экспорт функ найти[T](массив: Массив(T), предикат: функ(T) -> Булево) -> Опция(T)
	для элемент в массив цикл
		если предикат(элемент) тогда
			возврат Опция.Есть(элемент)
		конец
	конец
	Опция.Нет()
конец

/// Индекс первого элемента, для которого предикат вернул истину.
экспорт функ индекс_где[T](массив: Массив(T), предикат: функ(T) -> Булево) -> Опция(Целое)
	пер i: Целое = 0
	для элемент в массив цикл
		если предикат(элемент) тогда
			возврат Опция.Есть(i)
		конец
		i = i + 1
	конец
	Опция.Нет()
конец

/// Истина, если хотя бы один элемент удовлетворяет предикату.
экспорт функ любой[T](массив: Массив(T), предикат: функ(T) -> Булево) -> Булево
	для элемент в массив цикл
		если предикат(элемент) тогда
			возврат истина
		конец
	конец
	ложь
конец

/// Истина, если ВСЕ элементы удовлетворяют предикату (пустой массив — истина).
экспорт функ все[T](массив: Массив(T), предикат: функ(T) -> Булево) -> Булево
	для элемент в массив цикл
		если предикат(элемент) == ложь тогда
			возврат ложь
		конец
	конец
	истина
конец

/// Копия массива без повторяющихся элементов (порядок первого вхождения
/// сохраняется). Сравнение — через нативный `.содержит()` (структурное
/// равенство на уровне VM, работает для любого T, не только примитивов).
экспорт функ уникальные[T](массив: Массив(T)) -> Массив(T)
	пер результат: Массив(T) = массив()
	для элемент в массив цикл
		если результат.содержит(элемент) == ложь тогда
			результат.добавить(элемент)
		конец
	конец
	результат
конец

/// Копия массива в обратном порядке.
экспорт функ развернуть[T](массив: Массив(T)) -> Массив(T)
	пер результат: Массив(T) = массив()
	пер i = массив.длина() - 1
	пока i > -1 цикл
		результат.добавить(массив[i])
		i = i - 1
	конец
	результат
конец

/// Группирует элементы по строковому ключу. Ключ сознательно ограничен
/// `Строка` (а не произвольным generic K) — так группировка опирается
/// на нативную `Соответствие.получить`/`.есть` вместо реализации
/// key-equality вручную.
экспорт функ сгруппировать[T](массив: Массив(T), ключ: функ(T) -> Строка) -> Соответствие(Строка, Массив(T))
	пер результат: Соответствие(Строка, Массив(T)) = соответствие()
	для элемент в массив цикл
		пер к = ключ(элемент)
		пер текущие = результат.получить(к, массив())
		текущие.добавить(элемент)
		результат[к] = текущие
	конец
	результат
конец

/// Попарно объединяет два массива в массив кортежей — до длины короче из двух.
экспорт функ zip[T, U](а: Массив(T), б: Массив(U)) -> Массив((T, U))
	пер результат: Массив((T, U)) = массив()
	пер предел = а.длина()
	если б.длина() < предел тогда
		предел = б.длина()
	конец
	пер i: Целое = 0
	пока i < предел цикл
		результат.добавить((а[i], б[i]))
		i = i + 1
	конец
	результат
конец

/// Разбивает массив на куски фиксированного размера (последний кусок
/// может быть короче). `размер <= 0` — пустой результат.
экспорт функ фрагменты[T](массив: Массив(T), размер: Целое) -> Массив(Массив(T))
	пер результат: Массив(Массив(T)) = массив()
	если размер <= 0 тогда
		возврат результат
	конец
	пер текущий: Массив(T) = массив()
	для элемент в массив цикл
		текущий.добавить(элемент)
		если текущий.длина() == размер тогда
			результат.добавить(текущий)
			текущий = массив()
		конец
	конец
	если текущий.длина() > 0 тогда
		результат.добавить(текущий)
	конец
	результат
конец
