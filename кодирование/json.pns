импорт строки
импорт "./экранирование" как экран

// JSON: разбор + сериализация. Тот же архитектурный паттерн, что
// std/кодирование/toml.ps (Токенизатор -> Токен -> рекурсивный Парсер,
// Результат-based ошибки), но с полноценными escape-последовательностями
// в строках (TOML-версия их не разбирает) и сериализацией в обратную
// сторону (у toml.ps её нет). Числа — всегда Число (f64), большие целые
// теряют точность, как и везде в panos.

/// Один лексический токен JSON (тип + сырое значение).
экспорт тип Токен = структура
	тип_: Строка
	значение: Строка
конец

тип Токенизатор = структура
	текст: Строка
	поз: Целое
	длина: Целое
конец

функ новый_токенизатор(содержимое: Строка) -> Токенизатор
	Токенизатор(содержимое, 0, длина(содержимое))
конец

реализация Токенизатор
	функ прочитать_строку(это: Токенизатор) -> Токен
		это.поз = это.поз + 1
		пер результат = ""
		пока это.поз < это.длина и это.текст[это.поз] <> "\"" цикл
			пер символ = это.текст[это.поз]
			если символ == "\\" тогда
				это.поз = это.поз + 1
				если это.поз == это.длина тогда
					паника("json: незакрытая escape-последовательность")
				конец
				пер следующий = это.текст[это.поз]
				если следующий == "u" тогда
					это.поз = это.поз + 1
					пер точка = это.прочитать_hex4()
					// Суррогатная пара (codepoint за пределами BMP,
					// например эмодзи) — JSON кодирует его ДВУМЯ \u
					// escape'ами подряд (высокий D800-DBFF, низкий
					// DC00-DFFF), не одним; без комбинирования это
					// молча дало бы 2 отдельных (невалидных сами по
					// себе) codepoint'а вместо одного настоящего.
					если точка >= 55296 и точка <= 56319 и это.поз + 1 < это.длина и это.текст[это.поз] == "\\" и это.текст[это.поз + 1] == "u" тогда
						это.поз = это.поз + 2
						пер низкий = это.прочитать_hex4()
						точка = 65536 + (точка - 55296) * 1024 + (низкий - 56320)
					конец
					результат = результат + строки.из_рун(массив(точка))
					продолжить
				конец
				пер добавка = следующий
				если следующий == "n" тогда
					добавка = "\n"
				конец
				если следующий == "t" тогда
					добавка = "\t"
				конец
				если следующий == "r" тогда
					добавка = "\r"
				конец
				результат = результат + добавка
				это.поз = это.поз + 1
			иначе
				результат = результат + символ
				это.поз = это.поз + 1
			конец
		конец
		если это.поз == это.длина тогда
			паника("json: незакрытая строка")
		конец
		это.поз = это.поз + 1
		Токен("СТРОКА", результат)
	конец

	// Читает ровно 4 hex-цифры начиная с текущей позиции, возвращает их
	// как число 0..65535. Продвигает позицию на 4.
	функ прочитать_hex4(это: Токенизатор) -> Целое
		пер значение: Целое = 0
		пер i: Целое = 0
		пока i < 4 цикл
			если это.поз >= это.длина тогда
				паника("json: незавершённый \\u escape")
			конец
			значение = значение * 16 + это.hex_значение(это.текст[это.поз])
			это.поз = это.поз + 1
			i = i + 1
		конец
		значение
	конец

	функ hex_значение(это: Токенизатор, символ: Строка) -> Целое
		если символ == "0" тогда возврат 0 конец
		если символ == "1" тогда возврат 1 конец
		если символ == "2" тогда возврат 2 конец
		если символ == "3" тогда возврат 3 конец
		если символ == "4" тогда возврат 4 конец
		если символ == "5" тогда возврат 5 конец
		если символ == "6" тогда возврат 6 конец
		если символ == "7" тогда возврат 7 конец
		если символ == "8" тогда возврат 8 конец
		если символ == "9" тогда возврат 9 конец
		если символ == "a" или символ == "A" тогда возврат 10 конец
		если символ == "b" или символ == "B" тогда возврат 11 конец
		если символ == "c" или символ == "C" тогда возврат 12 конец
		если символ == "d" или символ == "D" тогда возврат 13 конец
		если символ == "e" или символ == "E" тогда возврат 14 конец
		если символ == "f" или символ == "F" тогда возврат 15 конец
		паника("json: неверная hex-цифра в \\u escape: '" + символ + "'")
	конец

	функ прочитать_число(это: Токенизатор) -> Токен
		пер начало = это.поз
		если это.поз < это.длина и это.текст[это.поз] == "-" тогда
			это.поз = это.поз + 1
		конец
		пока это.поз < это.длина и строки.это_цифра(это.текст[это.поз]) цикл
			это.поз = это.поз + 1
		конец
		если это.поз < это.длина и это.текст[это.поз] == "." тогда
			это.поз = это.поз + 1
			пока это.поз < это.длина и строки.это_цифра(это.текст[это.поз]) цикл
				это.поз = это.поз + 1
			конец
		конец
		если это.поз < это.длина и (это.текст[это.поз] == "e" или это.текст[это.поз] == "E") тогда
			это.поз = это.поз + 1
			если это.поз < это.длина и (это.текст[это.поз] == "+" или это.текст[это.поз] == "-") тогда
				это.поз = это.поз + 1
			конец
			пока это.поз < это.длина и строки.это_цифра(это.текст[это.поз]) цикл
				это.поз = это.поз + 1
			конец
		конец
		Токен("ЧИСЛО", строки.срез(это.текст, начало, это.поз))
	конец

	функ прочитать_ключевое_слово(это: Токенизатор) -> Токен
		пер начало = это.поз
		пока это.поз < это.длина и строки.это_буква(это.текст[это.поз]) цикл
			это.поз = это.поз + 1
		конец
		пер значение = строки.срез(это.текст, начало, это.поз)
		если значение == "true" тогда
			возврат Токен("БУЛЕВО", "true")
		конец
		если значение == "false" тогда
			возврат Токен("БУЛЕВО", "false")
		конец
		если значение == "null" тогда
			возврат Токен("НОЛЬ", "null")
		конец
		паника("json: неизвестное ключевое слово '" + значение + "'")
	конец

	функ следующий_токен(это: Токенизатор) -> Токен
		пока это.поз < это.длина цикл
			пер символ = это.текст[это.поз]
			если символ == " " или символ == "\t" или символ == "\r" или символ == "\n" тогда
				это.поз = это.поз + 1
				продолжить
			конец

			если символ == "{" тогда
				это.поз = это.поз + 1
				возврат Токен("ЛЕВАЯ_ФИГУРНАЯ", "{")
			конец
			если символ == "}" тогда
				это.поз = это.поз + 1
				возврат Токен("ПРАВАЯ_ФИГУРНАЯ", "}")
			конец
			если символ == "[" тогда
				это.поз = это.поз + 1
				возврат Токен("ЛЕВАЯ_СКОБКА", "[")
			конец
			если символ == "]" тогда
				это.поз = это.поз + 1
				возврат Токен("ПРАВАЯ_СКОБКА", "]")
			конец
			если символ == ":" тогда
				это.поз = это.поз + 1
				возврат Токен("ДВОЕТОЧИЕ", ":")
			конец
			если символ == "," тогда
				это.поз = это.поз + 1
				возврат Токен("ЗАПЯТАЯ", ",")
			конец
			если символ == "\"" тогда
				возврат это.прочитать_строку()
			конец
			если строки.это_буква(символ) тогда
				возврат это.прочитать_ключевое_слово()
			конец
			если строки.это_цифра(символ) или символ == "-" тогда
				возврат это.прочитать_число()
			конец

			паника("json: неизвестный символ '" + символ + "'")
		конец
		Токен("КОНЕЦ", "")
	конец
конец

/// Разобранное JSON-значение (null/булево/число/строка/список/объект).
экспорт тип Значение = перечисление
	Ноль
	Булево(Булево)
	Число(Число)
	Строка(Строка)
	Список(Массив(Значение))
	Объект(Соответствие(Строка, Значение))
конец

реализация Значение
	функ как_строку(это: Значение) -> Опция(Строка)
		выбор это
			Строка(с) -> Опция.Есть(с)
			_ -> Опция.Нет()
		конец
	конец

	функ как_число(это: Значение) -> Опция(Число)
		выбор это
			Число(ч) -> Опция.Есть(ч)
			_ -> Опция.Нет()
		конец
	конец

	функ как_булево(это: Значение) -> Опция(Булево)
		выбор это
			Булево(б) -> Опция.Есть(б)
			_ -> Опция.Нет()
		конец
	конец

	// Опция(Значение) — отсутствие ключа и "ключ есть, но значение не
	// Объект" иначе неразличимы, а вызывающему обычно всё равно, что из
	// двух произошло (тот же выбор, что toml.ps's .поле).
	функ поле(это: Значение, ключ: Строка) -> Опция(Значение)
		выбор это
			Объект(о) ->
				если о.есть(ключ) тогда
					Опция.Есть(о.получить(ключ, Значение.Ноль))
				иначе
					Опция.Нет()
				конец
			_ -> Опция.Нет()
		конец
	конец

	функ элемент(это: Значение, индекс: Целое) -> Опция(Значение)
		выбор это
			Список(с) ->
				если с.есть(индекс) тогда
					Опция.Есть(с.получить(индекс, Значение.Ноль))
				иначе
					Опция.Нет()
				конец
			_ -> Опция.Нет()
		конец
	конец
конец

тип Парсер = структура
	т:     Токенизатор
	токен: Токен
конец

функ новый_парсер(текст: Строка) -> Парсер
	пер т = новый_токенизатор(текст)
	пер начальный = т.следующий_токен()
	Парсер(т, начальный)
конец

реализация Парсер
	функ шаг(это: Парсер) -> Пусто
		это.токен = это.т.следующий_токен()
	конец

	функ разобрать_значение(это: Парсер) -> Результат(Значение, Ошибка)
		если это.токен.тип_ == "СТРОКА" тогда
			пер знач = это.токен.значение
			это.шаг()
			возврат Результат.Успех(Значение.Строка(знач))
		конец

		если это.токен.тип_ == "ЧИСЛО" тогда
			пер текст = это.токен.значение
			это.шаг()
			возврат выбор строки.в_число(текст)
				Результат.Успех(ч) -> Результат.Успех(Значение.Число(ч))
				Результат.Неудача(ош) -> Результат.Неудача(ош)
			конец
		конец

		если это.токен.тип_ == "БУЛЕВО" тогда
			пер булево_знач = это.токен.значение == "true"
			это.шаг()
			возврат Результат.Успех(Значение.Булево(булево_знач))
		конец

		если это.токен.тип_ == "НОЛЬ" тогда
			это.шаг()
			возврат Результат.Успех(Значение.Ноль)
		конец

		если это.токен.тип_ == "ЛЕВАЯ_СКОБКА" тогда
			это.шаг()
			пер элементы: Массив(Значение) = массив()
			если это.токен.тип_ <> "ПРАВАЯ_СКОБКА" тогда
				пока истина цикл
					пер элемент_результат = это.разобрать_значение()
					если элемент_результат.ошибка() тогда
						возврат элемент_результат
					конец
					элементы.добавить(элемент_результат.получить(Значение.Ноль))

					если это.токен.тип_ == "ЗАПЯТАЯ" тогда
						это.шаг()
					иначе
						прервать
					конец
				конец
			конец
			если это.токен.тип_ <> "ПРАВАЯ_СКОБКА" тогда
				возврат Результат.Неудача(Ошибка("json", "ожидалась ']'"))
			конец
			это.шаг()
			возврат Результат.Успех(Значение.Список(элементы))
		конец

		если это.токен.тип_ == "ЛЕВАЯ_ФИГУРНАЯ" тогда
			это.шаг()
			пер поля: Соответствие(Строка, Значение) = соответствие()
			если это.токен.тип_ <> "ПРАВАЯ_ФИГУРНАЯ" тогда
				пока истина цикл
					если это.токен.тип_ <> "СТРОКА" тогда
						возврат Результат.Неудача(Ошибка("json", "ожидался ключ-строка"))
					конец
					пер ключ = это.токен.значение
					это.шаг()
					если это.токен.тип_ <> "ДВОЕТОЧИЕ" тогда
						возврат Результат.Неудача(Ошибка("json", "ожидалось ':' после ключа"))
					конец
					это.шаг()
					пер значение_результат = это.разобрать_значение()
					если значение_результат.ошибка() тогда
						возврат значение_результат
					конец
					поля[ключ] = значение_результат.получить(Значение.Ноль)

					если это.токен.тип_ == "ЗАПЯТАЯ" тогда
						это.шаг()
					иначе
						прервать
					конец
				конец
			конец
			если это.токен.тип_ <> "ПРАВАЯ_ФИГУРНАЯ" тогда
				возврат Результат.Неудача(Ошибка("json", "ожидалась '}'"))
			конец
			это.шаг()
			возврат Результат.Успех(Значение.Объект(поля))
		конец

		возврат Результат.Неудача(Ошибка("json", "ожидалось значение, получено: " + это.токен.значение))
	конец
конец

/// Строит Значение.Объект из пар (ключ, значение) — удобнее ручной
/// сборки через Значение.Объект(соответствие(...)).
экспорт функ объект(поля: Массив((Строка, Значение))) -> Значение
	пер результат: Соответствие(Строка, Значение) = соответствие()
	для запись в поля цикл
		результат[запись.0] = запись.1
	конец
	Значение.Объект(результат)
конец

/// Строит Значение.Список из массива значений.
экспорт функ список(элементы: Массив(Значение)) -> Значение
	Значение.Список(элементы)
конец

/// Разбирает JSON-текст в дерево Значение.
экспорт функ разобрать(текст: Строка) -> Результат(Значение, Ошибка)
	пер п = новый_парсер(текст)
	пер результат = п.разобрать_значение()
	если результат.ошибка() тогда
		возврат результат
	конец
	если п.токен.тип_ <> "КОНЕЦ" тогда
		возврат Результат.Неудача(Ошибка("json", "лишние данные после значения"))
	конец
	результат
конец

// `истина` — экранировать управляющие байты < 0x20 через \u00XX (не
// только \n/\t/\r) — валидный JSON запрещает их сырыми в строковых
// литералах; исторически здесь стояло `ложь` (см. экранирование.pns
// шапку), что могло дать невалидный JSON на выходе для текста с такими
// байтами.
функ экранировать(текст: Строка) -> Строка
	экран.экранировать_базовое(текст, истина)
конец

/// Сериализует дерево Значение обратно в JSON-текст.
экспорт функ сериализовать(значение: Значение) -> Строка
	выбор значение
		Ноль -> "null"
		Булево(б) ->
			если б тогда
				"true"
			иначе
				"false"
			конец
		Число(ч) -> строки.из_числа(ч)
		Строка(с) -> "\"" + экранировать(с) + "\""
		Список(элементы) -> сериализовать_список(элементы)
		Объект(поля) -> сериализовать_объект(поля)
	конец
конец

функ сериализовать_список(элементы: Массив(Значение)) -> Строка
	пер результат = "["
	пер i: Целое = 0
	пер n = элементы.длина()
	пока i < n цикл
		результат = результат + сериализовать(элементы.получить(i, Значение.Ноль))
		если i < n - 1 тогда
			результат = результат + ","
		конец
		i = i + 1
	конец
	результат + "]"
конец

функ сериализовать_объект(поля: Соответствие(Строка, Значение)) -> Строка
	пер записи = поля.записи()
	пер результат = "{"
	пер i: Целое = 0
	пер n = записи.длина()
	пока i < n цикл
		пер запись = записи.получить(i, ("", Значение.Ноль))
		результат = результат + "\"" + экранировать(запись.0) + "\":" + сериализовать(запись.1)
		если i < n - 1 тогда
			результат = результат + ","
		конец
		i = i + 1
	конец
	результат + "}"
конец

// ==================== ИНТЕРФЕЙСЫ ДЕСЕРИАЛИЗАЦИИ/СЕРИАЛИЗАЦИИ ====================
//
// Тот же паттерн, что ИзTOML/ВTOML в std/кодирование/toml.ps: в panos нет
// reflection/derive, структура не может "автоматически" сериализоваться
// просто по факту наличия полей. Вместо этого — структура РЕАЛИЗУЕТ
// ИзJSON/ВJSON один раз (тело обычно пишет codegen — см.
// ../panosiki/codegen, генератор &Json — а не руками), а дальше
// вызывается единообразно через generic-обёртки ниже (разобрать_в/
// сериализовать_из), а не по конкретному имени X_из_json/X_в_json на
// каждом call site.
//
// заполнить_из_json мутирует УЖЕ СУЩЕСТВУЮЩИЙ инстанс (это.поле = ...),
// а не строит новый — в panos нет способа сконструировать T "из ничего"
// внутри generic-кода (интерфейсные методы всегда диспетчеризуются на
// существующем это, конструкторов интерфейс не даёт), так что вызывающий
// код сам создаёт нулевой/дефолтный инстанс перед вызовом.

/// Реализуйте на структуре, чтобы заполнять её поля напрямую из JSON (см. разобрать_в).
экспорт тип ИзJSON = интерфейс
	функ заполнить_из_json(значение: Значение) -> Опция(Ошибка)
конец

/// Реализуйте на структуре, чтобы сериализовать её поля в JSON (см. сериализовать_из).
экспорт тип ВJSON = интерфейс
	функ в_json() -> Значение
конец

// Разбирает `текст` и заполняет им уже существующий `это` (созданный
// вызывающим кодом, обычно с нулевыми/дефолтными полями). Опция(Ошибка)
// одинаково покрывает и ошибку разбора текста, и ошибку самого маппинга
// полей (см. заполнить_из_json конкретной структуры).
/// Разбирает текст и заполняет им уже существующий инстанс T (реализующий ИзJSON).
экспорт функ разобрать_в[T: ИзJSON](это: T, текст: Строка) -> Опция(Ошибка)
	пер рез = разобрать(текст)
	если рез.ошибка() тогда
		возврат Опция.Есть(рез.причина())
	конец
	это.заполнить_из_json(рез.получить(Значение.Ноль))
конец

// Обратное: структура -> Значение (через .в_json()) -> JSON-текст.
/// Сериализует T (реализующий ВJSON) в JSON-текст.
экспорт функ сериализовать_из[T: ВJSON](это: T) -> Строка
	сериализовать(это.в_json())
конец
