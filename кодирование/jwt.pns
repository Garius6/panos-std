// jwt.pns — HS256 JWT (RFC 7519): создать/проверить поверх крипто.* +
// кодирование/json.pns. Полезная нагрузка — обычный json.Значение
// (Объект), а не типизированная структура — тот же "flat data" принцип,
// что у кодирование/json.pns и синтаксис.* (нет отдельного generic-типа
// для claims, вызывающий сам достаёт нужные поля через .поле(...)).
//
// Только HS256 — единственный алгоритм, для которого есть builtin
// (крипто.hmac_sha256_base64url). Заголовок алгоритма из ВХОДЯЩЕГО
// токена НИКОГДА не читается для выбора алгоритма проверки (классическая
// JWT "alg confusion"/"none"-атака) — проверить() всегда пересчитывает
// подпись как HS256 и сравнивает константным временем, что бы ни было
// написано в заголовке токена.

импорт крипто
импорт "кодирование/json" как json
импорт строки
импорт время

функ заголовок_hs256() -> Строка
	json.сериализовать(json.объект(массив(
		("alg", json.Значение.Строка("HS256")),
		("typ", json.Значение.Строка("JWT"))
	)))
конец

/// Создаёт HS256 JWT: base64url(заголовок) "." base64url(нагрузка) "."
/// подпись. `нагрузка` — обычный json.Значение.Объект(...) — добавьте
/// поле "exp" (Число, unix-секунды) сами, если токен должен истекать;
/// проверить() ниже проверяет "exp", только если оно присутствует.
экспорт функ создать(секрет: Строка, нагрузка: json.Значение) -> Строка
	пер заголовок_b64 = крипто.base64url_кодировать(заголовок_hs256())
	пер нагрузка_b64 = крипто.base64url_кодировать(json.сериализовать(нагрузка))
	пер вход_подписи = заголовок_b64 + "." + нагрузка_b64
	пер подпись = крипто.hmac_sha256_base64url(секрет, вход_подписи)
	вход_подписи + "." + подпись
конец

/// Проверяет подпись (константное время) и, если claim "exp"
/// присутствует, срок годности — возвращает разобранную нагрузку как
/// json.Значение при успехе. Синтаксическая ошибка (не 3 сегмента,
/// невалидный base64url, невалидный JSON) и неверная/просроченная
/// подпись — обе Результат.Неудача (Ошибка("jwt", ...)), не разные
/// исходы: вызывающему обычно всё равно, что именно не так с чужим
/// токеном, только что он невалиден.
экспорт функ проверить(секрет: Строка, токен: Строка) -> Результат(json.Значение, Ошибка)
	пер части = строки.разбить(токен, ".")
	если части.длина() <> 3 тогда
		возврат Результат.Неудача(Ошибка("jwt", "токен должен состоять из 3 сегментов"))
	конец
	пер заголовок_b64 = части.получить(0, "")
	пер нагрузка_b64 = части.получить(1, "")
	пер подпись_b64 = части.получить(2, "")

	пер вход_подписи = заголовок_b64 + "." + нагрузка_b64
	пер ожидаемая_подпись = крипто.hmac_sha256_base64url(секрет, вход_подписи)
	если не крипто.сравнить_константное_время(ожидаемая_подпись, подпись_b64) тогда
		возврат Результат.Неудача(Ошибка("jwt", "неверная подпись"))
	конец

	пер нагрузка_json_рез = крипто.base64url_декодировать(нагрузка_b64)
	если нагрузка_json_рез.ошибка() тогда
		возврат Результат.Неудача(нагрузка_json_рез.причина())
	конец
	пер нагрузка_рез = json.разобрать(нагрузка_json_рез.значение())
	если нагрузка_рез.ошибка() тогда
		возврат Результат.Неудача(нагрузка_рез.причина())
	конец
	пер нагрузка = нагрузка_рез.значение()

	пер истечение = нагрузка.поле("exp")
	если истечение.есть() тогда
		пер истечение_число = истечение.получить(json.Значение.Ноль).как_число()
		если истечение_число.есть() тогда
			пер сейчас_секунд = время.сейчас_мс() / 1000.0
			если сейчас_секунд > истечение_число.получить(0.0) тогда
				возврат Результат.Неудача(Ошибка("jwt", "токен истёк"))
			конец
		конец
	конец

	Результат.Успех(нагрузка)
конец
